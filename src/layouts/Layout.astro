---
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';

const {
	title = 'Автосервіс у Львові — якісний ремонт авто з гарантією',
	description = 'AutoFix — сучасне СТО у Львові. Комп’ютерна діагностика, ТО за 45 хв, ремонт ходової, двигунів і гальм. Фіксований кошторис та офіційна гарантія 12 місяців.',
} = Astro.props;
---

<!doctype html>
<html
	lang="uk"
	data-theme="dark"
	class="dark [--r-sm:8px] [--r-md:12px] [--r-lg:16px] [--r-xl:20px] [scroll-behavior:smooth] [overflow-x:clip] [-webkit-text-size-adjust:100%] [--bg:#080b0d] [--panel:#111618] [--panel2:#111618] [--red:#f44336] [--muted:#929891] [--line:#272b2d] [--font:'Barlow',_'Arial',_sans-serif] [--display:var(--font)] [scroll-padding-top:88px] [@media(prefers-reduced-motion:reduce)]:[scroll-behavior:auto] [@media(max-width:640px)]:[scroll-padding-top:68px]"
>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width,initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#080b0d" />
		<meta name="color-scheme" content="dark" />
		<title>{title} — AutoFix Львів</title>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600;700;800&display=swap"
			rel="stylesheet"
		/>
		<script type="application/ld+json" is:inline>
			{
				"@context": "https://schema.org",
				"@type": "AutoRepair",
				"name": "AutoFix — СТО у Львові",
				"description": "Сучасний автосервіс повного циклу у Львові. Комп’ютерна діагностика, ТО за 45 хв, ремонт ходової, двигунів і гальм із гарантією 12 місяців.",
				"url": "https://autofix.lviv.ua",
				"telephone": "+380631234567",
				"priceRange": "₴₴",
				"address": {
					"@type": "PostalAddress",
					"streetAddress": "вул. Городоцька, 224",
					"addressLocality": "Львів",
					"postalCode": "79040",
					"addressCountry": "UA"
				},
				"geo": {
					"@type": "GeoCoordinates",
					"latitude": 49.8327,
					"longitude": 23.9743
				},
				"openingHoursSpecification": [
					{
						"@type": "OpeningHoursSpecification",
						"dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
						"opens": "08:30",
						"closes": "19:30"
					},
					{
						"@type": "OpeningHoursSpecification",
						"dayOfWeek": ["Sunday"],
						"opens": "09:00",
						"closes": "16:00"
					}
				]
			}
		</script>
	</head>
	<body class="min-h-screen font-sans antialiased [min-width:320px] [overflow-x:clip] [-webkit-font-smoothing:antialiased] [&[hidden]]:[display:none!important] !bg-transparent [color:var(--text-title,#f4f3ef)] [font:16px/1.65_var(--font)] [letter-spacing:-0.01em] [@media(prefers-reduced-motion:reduce)]:[&_*]:[transition:none!important] [@media(prefers-reduced-motion:reduce)]:[&_*]:[animation:none!important] [@media(prefers-reduced-motion:reduce)]:[&_*:before]:[transition:none!important] [@media(prefers-reduced-motion:reduce)]:[&_*:before]:[animation:none!important] [@media(prefers-reduced-motion:reduce)]:[&_*:after]:[transition:none!important] [@media(prefers-reduced-motion:reduce)]:[&_*:after]:[animation:none!important] [@media(max-width:640px)]:[&_.header-inner]:[height:50px] [@media(max-width:640px)]:[&_.header-inner]:[gap:6px] [@media(max-width:640px)]:[&_.header-inner]:[padding-inline:10px] [@media(max-width:640px)]:[&_.brand-mark]:[width:24px] [@media(max-width:640px)]:[&_.brand-mark]:[height:24px] [@media(max-width:640px)]:[&_.header-book]:[min-height:32px!important] [@media(max-width:640px)]:[&_.header-book]:[padding:5px_9px!important] [@media(max-width:640px)]:[&_.header-book]:[border-radius:8px!important] [position:relative] [isolation:isolate] [&::before]:[content:''] [&::before]:[position:fixed] [&::before]:[inset:-12px] [&::before]:[z-index:0] [&::before]:[background-image:linear-gradient(var(--page-wash),_var(--page-wash)),_var(--page-background-image)] [&::before]:[background-position:center] [&::before]:[background-size:cover] [&::before]:[filter:blur(8px)] [&::before]:[transform:scale(1.02)] [&::before]:[pointer-events:none] [&_>_main]:[position:relative] [&_>_main]:[z-index:1] [&_>_footer]:[position:relative] [&_>_footer]:[z-index:1] [&_.services-page]:!bg-transparent [&_.landing-page]:!bg-transparent [&_.home-page]:!bg-transparent [&>main]:[width:100%] [@media(max-width:640px)]:[&>main]:[min-width:0]">
		<Header />
		<main>
			<slot />
		</main>
		<Footer />
		<script>
			// Усі кнопки «Записатися» ведуть на сторінку онлайн-запису
			document.querySelectorAll<HTMLButtonElement>('[data-book]').forEach((btn) =>
				btn.addEventListener('click', () => {
					window.location.href =
						'/booking/' +
						(btn.dataset.service ? '?service=' + encodeURIComponent(btn.dataset.service) : '');
				}),
			);

			// Плавна поява блоків сайту при прокручуванні (reveal on scroll)
			if (window.matchMedia('(prefers-reduced-motion: no-preference)').matches) {
				const observer = new IntersectionObserver(
					(entries) => {
						entries.forEach((entry) => {
							if (entry.isIntersecting) {
								entry.target.classList.add('is-visible');
								observer.unobserve(entry.target);
							}
						});
					},
					{ threshold: 0.04, rootMargin: '0px 0px -20px 0px' },
				);

				document.querySelectorAll('main section, main article').forEach((el) => {
					el.classList.add('reveal-on-scroll');
					observer.observe(el);
				});
			}
		</script>
	</body>
</html>
