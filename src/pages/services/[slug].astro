---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import MetricStrip from '../../components/ui/MetricStrip.astro';
import Button from '../../components/ui/Button.astro';
import {
	ArrowRight,
	CalendarDays,
	Check,
	CheckCircle2,
	Clock3,
	Gauge,
	Phone,
	Settings,
	ShieldCheck,
