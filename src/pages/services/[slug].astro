} from 'lucide-react';
import { prices, services } from '../../data';

export function getStaticPaths() {
	return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

const { service } = Astro.props;
const servicePrices = prices[service.category] ?? [];
const startingPrice = servicePrices[0]?.[1] ?? service.price;
const tierPrices = [
	startingPrice,
	Math.round((startingPrice * 1.65) / 10) * 10,
	Math.round((startingPrice * 2.5) / 10) * 10,
];
const priceTiers = [
	{
		name: 'Базовий комплекс',
		note: 'Основні регламентні роботи за стандартом виробника',
		price: tierPrices[0],
