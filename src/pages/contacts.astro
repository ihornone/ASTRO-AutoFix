---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/ui/PageHero.astro';
import MetricStrip from '../components/ui/MetricStrip.astro';
import Button from '../components/ui/Button.astro';
import MapEmbed from '../components/ui/MapEmbed.astro';
import ScheduleList from '../components/ui/ScheduleList.astro';
import SocialLinks from '../components/ui/SocialLinks.astro';
import { ArrowRight, CalendarDays, Car, Clock, Mail, MapPin, Phone } from 'lucide-react';
import { site } from '../data';

const metrics = [
	{ icon: MapPin, title: 'Зручна локація', text: site.address },
	{
		icon: Car,
		title: 'Паркінг і зона очікування',
		text: 'Wi-Fi, кава, панорамний огляд цеху',
	},
	{ icon: Clock, title: 'Графік без вихідних', text: site.hoursFull },
	{ icon: Phone, title: 'Прямий зв’язок', text: site.phone + ' (Viber, Telegram)' },
];

const directContacts = [
	{ icon: Phone, title: 'Телефон приймальника', text: site.phone },
	{ icon: Mail, title: 'Електронна пошта', text: site.email },
	{ icon: MapPin, title: 'Адреса автосервісу', text: site.address },
];

const inputClass =
	'mt-1 block w-full rounded-lg border border-[#464b45] bg-[#111416] px-3 py-2 text-sm text-[#f4f3ef] placeholder:text-white/40 focus:border-[#f44336] focus:outline-1 focus:outline-[#f44336]';
---

<Layout title="Контакти">
	<div class="services-page contacts-page text-[#f4f3ef] [padding-bottom:28px]">
		<PageHero
			crumbs={[{ href: '/', label: 'Головна' }, { label: 'Контакти' }]}
			intro={
				site.address +
				' (зручний заїзд). Працюємо без вихідних: ' +
				site.hoursFull +
				'. Консультація майстра та швидкий прорахунок кошторису.'
			}
		>
			<Fragment slot="title">
				Контакти <span>AutoFix Львів</span>
			</Fragment>
			<Button href="/booking/">
				<CalendarDays size={19} />
				Записатись на сервіс <ArrowRight size={17} />
			</Button>
			<Button variant="outline" href="#contact-message">
				<Mail size={18} />
				Написати майстру
			</Button>
		</PageHero>

		<MetricStrip items={metrics} />

		<section class="container mx-auto w-full max-w-[1320px] px-4 py-8 sm:px-6 md:py-12 lg:px-8">
			<div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
				{/* Ліва колонка */}
				<div class="flex flex-col gap-6">
					<section class="rounded-2xl border border-white/10 bg-[#111618] p-5 sm:p-7">
						<h2 class="mb-4 text-base font-bold tracking-tight text-white sm:text-2xl">
							Прямі <span class="text-[#f44336]">контакти</span>
						</h2>
						<div class="space-y-4">
							{directContacts.map(({ icon: Icon, title, text }) => (
								<div class="flex items-start gap-3.5 border-t border-white/10 pt-3.5 first:border-0 first:pt-0">
									<span class="mt-0.5 flex size-10 shrink-0 items-center justify-center rounded-xl border border-[#f44336]/30 bg-[#f44336]/10 text-[#f44336]">
										<Icon size={18} />
									</span>
									<div class="min-w-0 flex-1">
										<strong class="block text-sm text-[#b3b8b2]">{title}</strong>
										<span class="mt-0.5 block text-sm font-bold text-white sm:text-base">
											{text}
										</span>
									</div>
								</div>
							))}
						</div>
					</section>

					<section class="rounded-2xl border border-white/10 bg-[#111618] p-5 sm:p-7">
						<h2 class="mb-4 text-base font-bold tracking-tight text-white sm:text-2xl">
							Графік роботи
						</h2>
						<ScheduleList class="mb-4" />
						<p id="opening-status" class="mb-0 text-sm font-medium text-[#b3b8b2]" role="status">
							Працюємо без вихідних · прийом авто за попереднім записом
						</p>
					</section>

					<section class="flex-1 rounded-2xl border border-white/10 bg-[#111618] p-5 sm:p-7">
						<h2 class="mb-4 text-base font-bold tracking-tight text-white sm:text-2xl">
							Ми в соцмережах
						</h2>
						<SocialLinks class="grid grid-cols-2 gap-2.5 sm:grid-cols-3" />
					</section>
				</div>

				{/* Права колонка */}
				<div class="flex flex-col gap-6">
					<section class="overflow-hidden rounded-2xl border border-white/10 bg-[#111618] p-5 sm:p-7">
						<h2 class="mb-4 text-base font-bold tracking-tight text-white sm:text-2xl">
							Як нас <span class="text-[#f44336]">знайти?</span>
						</h2>
						<MapEmbed height="h-64 sm:h-80" class="rounded-xl" />
					</section>

					<section
						class="flex-1 rounded-2xl border border-white/10 bg-[#111618] p-5 sm:p-7"
						id="contact-message"
					>
						<h2 class="mb-2 text-base font-bold tracking-tight text-white sm:text-2xl">
							Напишіть <span class="text-[#f44336]">нам</span>
						</h2>
						<p class="mb-5 text-sm text-[#b3b8b2]">
							Маєте питання чи потрібна оцінка за фото? Надішліть повідомлення і ми зв’яжемося за 10
							хв.
						</p>
						<form class="space-y-4" id="contact-form">
							<div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
								<label class="block">
									<span class="mb-1.5 block text-sm font-semibold text-[#b3b8b2]">Ваше ім’я *</span>
									<input
										class={inputClass}
										name="name"
										required
										minlength="2"
										autocomplete="given-name"
										placeholder="Як до вас звертатися?"
									/>
								</label>
								<label class="block">
									<span class="mb-1.5 block text-sm font-semibold text-[#b3b8b2]">Телефон *</span>
									<input
										class={inputClass}
										name="phone"
										type="tel"
										required
										pattern="[+0-9 ()-]{10,20}"
										autocomplete="tel"
										placeholder="+380 __ ___ __ __"
									/>
								</label>
							</div>
							<label class="block">
								<span class="mb-1.5 block text-sm font-semibold text-[#b3b8b2]">
									Email (необов’язково)
								</span>
								<input
									class={inputClass}
									name="email"
									type="email"
									autocomplete="email"
									placeholder="example@gmail.com"
								/>
							</label>
							<label class="block">
								<span class="mb-1.5 block text-sm font-semibold text-[#b3b8b2]">
									Ваше повідомлення *
								</span>
								<textarea
									class={inputClass}
									name="message"
									rows="4"
									required
									placeholder="Опишіть ваше питання або симптоми несправності авто..."
								></textarea>
							</label>
							<Button type="submit" class="w-full rounded-xl px-6 py-3.5 sm:w-auto">
								Надіслати повідомлення <ArrowRight size={17} />
							</Button>
							<p id="contact-status" class="mb-0 mt-2 text-[#b3b8b2]" role="status"></p>
							<p class="mb-0 text-[#b3b8b2]">
								Натискаючи кнопку, ви погоджуєтеся на обробку даних для зв’язку з вами.
							</p>
						</form>
					</section>
				</div>
			</div>
		</section>

		<section class="container catalog-consultation contacts-final mx-auto my-8 flex w-full max-w-[1320px] flex-col items-start justify-between gap-4 rounded-2xl border border-white/10 bg-white/[0.03] px-4 py-6 sm:mx-auto sm:flex-row sm:items-center sm:justify-between sm:px-6 lg:px-8 [@media(max-width:900px)]:[flex-wrap:wrap]">
			<h2 class="mb-0 text-2xl font-semibold [font-family:var(--font)] [font-weight:600] [letter-spacing:-0.045em] [line-height:1.08] [text-wrap:balance]">
				Зручніше записатися
				<br />
				<span>онлайн?</span>
			</h2>
			<p class="mb-0 text-sm leading-6 text-white/60 [color:#b3b8b2]">
				Оберіть послугу, дату та час у нашій
				<br />
				системі онлайн-запису — це швидко,
				<br />
				просто та зручно!
			</p>
			<Button href="/booking/">
				<CalendarDays size={19} />
				Онлайн-запис <ArrowRight size={17} />
			</Button>
		</section>
	</div>
</Layout>

<script>
	const form = document.querySelector<HTMLFormElement>('#contact-form')!;
	const status = document.querySelector<HTMLElement>('#contact-status')!;
	form.addEventListener('submit', (event) => {
		event.preventDefault();
		try {
			localStorage.setItem(
				'autofix-contact-message',
				JSON.stringify(Object.fromEntries(new FormData(form))),
			);
			status.textContent =
				'Повідомлення збережено у вашому браузері. До сервісу воно ще не надіслане.';
			form.reset();
		} catch {
			status.textContent =
				'Не вдалося зберегти повідомлення. Дозвольте браузеру локальне збереження та спробуйте ще раз.';
		}
	});
	const parts = new Intl.DateTimeFormat('en-GB', {
		timeZone: 'Europe/Kyiv',
		weekday: 'short',
		hour: '2-digit',
		hourCycle: 'h23',
	}).formatToParts(new Date());
	const day = parts.find((part) => part.type === 'weekday')!.value;
	const hour = Number(parts.find((part) => part.type === 'hour')!.value);
	const open = day !== 'Sun' && hour >= 8 && hour < 20;
	const opening = document.querySelector<HTMLElement>('#opening-status')!;
	opening.textContent = open ? '● Зараз працюємо · до 19:30' : '● Зараз зачинено';
	opening.classList.toggle('is-open', open);
</script>
