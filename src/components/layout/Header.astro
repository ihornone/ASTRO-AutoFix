---
/**
 * Шапка сайту: фіксована панель, десктопна навігація, телефон,
 * кнопка запису, мобільне меню з бекдропом і перемикачем іконок.
 */
import { ArrowRight, Menu, Phone, X } from 'lucide-react';
import Brand from '../ui/Brand.astro';
import { nav, site } from '../../data';

const pathname = Astro.url.pathname;
---

<button
	id="menu-backdrop"
	type="button"
	aria-label="Закрити меню"
	class="fixed inset-0 z-40 bg-black/60 backdrop-blur-sm xl:hidden"
	hidden
	tabindex="-1"
></button>
<header class="header fixed inset-x-0 top-3 z-50 mx-auto w-[calc(100%-16px)] max-w-[1320px] rounded-2xl border border-white/10 bg-[#0a0e10]/85 shadow-lg shadow-black/40 backdrop-blur-xl sm:top-4 sm:w-[calc(100%-32px)]">
	<div class="header-inner mx-auto flex h-[60px] w-full max-w-none items-center gap-1 px-1.5 sm:gap-2 sm:px-5 md:h-[66px] md:gap-3 lg:px-8 xl:gap-4">
		<Brand />
		<nav
			class="desktop-nav mx-auto hidden h-full items-center justify-center gap-2 xl:flex xl:gap-3 2xl:gap-4.5"
			aria-label="Головна навігація"
		>
			{nav.map(([href, label]) => (
				<a
					href={href}
					class:list={[
						'whitespace-nowrap text-sm font-medium text-[#c0c4be] transition hover:text-[#f44336] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#f44336]',
						{ 'text-[#f44336]': pathname === href },
					]}
					aria-current={pathname === href ? 'page' : undefined}
				>
					{label}
				</a>
			))}
		</nav>
		<div class="ml-auto flex shrink-0 items-center gap-1 sm:gap-2.5 lg:gap-3.5">
			<a
				class="header-phone inline-flex items-center gap-1.5 sm:gap-2 text-sm font-semibold text-[#e9e9e4] transition hover:text-[#f44336] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#f44336]"
				href={site.phoneHref}
				aria-label={`Зателефонувати: ${site.phone}`}
			>
				<span class="flex size-8 shrink-0 items-center justify-center rounded-lg border border-white/10 bg-white/5 text-[#f44336] transition hover:border-[#f44336]/60 hover:bg-[#f44336]/10 sm:size-9 md:hidden">
					<Phone size={15} />
				</span>
				<Phone size={19} class="hidden text-[#f44336] md:inline" />
				<span class="hidden md:inline text-left">
					<span class="block whitespace-nowrap leading-tight">{site.phone}</span>
					<small class="mt-0.5 block font-normal leading-none text-[#929891]">
						{site.hoursWeekdays}
					</small>
				</span>
			</a>

			<button
				class="header-book inline-flex h-9 shrink-0 items-center justify-center gap-1 rounded-lg border border-[#f44336] bg-[#f44336] px-2 text-xs font-bold text-[#170f0f] transition hover:bg-[#ff5252] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#f44336] sm:h-10 sm:px-3 sm:text-sm sm:gap-2"
				data-book
			>
				Записатися <ArrowRight size={17} />
			</button>
			<button
				class="menu-toggle group inline-flex size-9 shrink-0 items-center justify-center rounded-lg border border-white/10 text-[#f4f3ef] transition hover:border-[#f44336]/50 hover:bg-white/5 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#f44336] xl:hidden sm:size-10"
				aria-label="Відкрити меню"
				aria-expanded="false"
				aria-controls="mobile-menu"
				type="button"
			>
				<span data-menu-icon>
					<Menu size={20} />
				</span>
				<span data-close-icon hidden>
					<X size={20} />
				</span>
			</button>
		</div>
	</div>
	<nav
		id="mobile-menu"
		hidden
		class="absolute inset-x-0 top-[calc(100%+8px)] max-h-[calc(100dvh-100px)] overflow-y-auto overscroll-contain rounded-2xl border border-[var(--page-border)] bg-[var(--bg)] p-4 shadow-2xl shadow-black/30 xl:hidden"
		aria-label="Мобільна навігація"
	>
		<div class="grid grid-cols-1 gap-2">
			{nav.map(([href, label]) => (
				<a
					class:list={[
						'flex min-h-12 items-center justify-between gap-2 rounded-lg border px-3 py-3 text-sm font-medium transition',
						pathname === href
							? 'border-[#f44336]/40 bg-[#f44336]/10 !text-[#f44336]'
							: 'border-[var(--page-border)] bg-[var(--page-card)] text-[var(--page-text)] hover:border-[#f44336]/40',
					]}
					href={href}
					aria-current={pathname === href ? 'page' : undefined}
				>
					{label}
					<ArrowRight size={14} class="opacity-50" />
				</a>
			))}
		</div>
		<div class="mt-4 flex items-center gap-3 border-t border-[var(--page-border)] pt-4">
			<div class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-[#f44336]/10 !text-[#f44336]">
				<Phone size={18} />
			</div>
			<div>
				<a
					href={site.phoneHref}
					class="text-sm font-semibold text-[var(--page-text)] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#f44336]"
				>
					{site.phone}
				</a>
				<small class="block text-[var(--page-muted)]">Щодня 09:00 – 19:00</small>
			</div>
		</div>
		<button
			type="button"
			class="mt-4 flex min-h-11 w-full items-center justify-between rounded-lg bg-[#f44336] px-4 py-3 text-sm font-bold text-[#170f0f] transition hover:bg-[#ff5252] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#f44336]"
			data-book
		>
			Записатися на сервіс <ArrowRight size={18} />
		</button>
	</nav>
</header>

<script>
	const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle')!;
	const menuIcon = toggle.querySelector<HTMLElement>('[data-menu-icon]')!;
	const closeIcon = toggle.querySelector<HTMLElement>('[data-close-icon]')!;
	const mobileMenu = document.querySelector<HTMLElement>('#mobile-menu')!;
	const backdrop = document.querySelector<HTMLButtonElement>('#menu-backdrop')!;
	const setMenuOpen = (open: boolean) => {
		menuIcon.hidden = open;
		closeIcon.hidden = !open;
		toggle.setAttribute('aria-expanded', String(open));
		toggle.setAttribute('aria-label', open ? 'Закрити меню' : 'Відкрити меню');
		mobileMenu.hidden = !open;
		backdrop.hidden = !open;
		document.body.style.overflow = open ? 'hidden' : '';
	};
	toggle.addEventListener('click', () =>
		setMenuOpen(toggle.getAttribute('aria-expanded') !== 'true'),
	);
	backdrop.addEventListener('click', () => setMenuOpen(false));
	mobileMenu
		.querySelectorAll('a, [data-book]')
		.forEach((link) => link.addEventListener('click', () => setMenuOpen(false)));
	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape' && !mobileMenu.hidden) {
			setMenuOpen(false);
			toggle.focus();
		}
	});
	window.matchMedia('(min-width: 1280px)').addEventListener('change', (event) => {
		if (event.matches) setMenuOpen(false);
	});
</script>
