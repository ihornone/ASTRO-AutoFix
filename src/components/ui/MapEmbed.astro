---
/** Вбудована карта OpenStreetMap з розташуванням сервісу. */
import { site } from '../../data';

interface Props {
	class?: string;
	height?: string;
}
const { class: className, height = 'h-60 sm:h-72' } = Astro.props;
---

<div class:list={['w-full overflow-hidden rounded-2xl border border-white/10', height, className]}>
	<iframe
		class="h-full w-full border-0"
		title="Карта розташування AutoFix у Львові"
		loading="lazy"
		src={site.mapEmbed}
		referrerpolicy="no-referrer-when-downgrade"
	></iframe>
</div>
