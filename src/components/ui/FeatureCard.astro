---
/**
 * Картка з іконкою, заголовком і текстом.
 * variant="row"    — горизонтальна (переваги на головній);
 * variant="stack"  — вертикальна з номером (кроки процесу, «як ми працюємо»).
 */
import type { LucideIcon } from 'lucide-react';

interface Props {
	icon: LucideIcon;
	title: string;
	text?: string;
	number?: string;
	variant?: 'row' | 'stack';
	iconSize?: number;
	class?: string;
}

const {
	icon: Icon,
	title,
	text,
	number,
	variant = 'row',
	iconSize = 20,
	class: className,
} = Astro.props;
---

{variant === 'row' ? (
	<article
		class:list={[
			'group relative flex items-start gap-3.5 rounded-xl border border-white/10 bg-[#111618]/90 p-4 transition duration-300 hover:-translate-y-0.5 hover:border-[#f44336]/60 hover:bg-[#111618]',
			className,
		]}
	>
		<span class="mt-0.5 flex size-10 shrink-0 items-center justify-center rounded-lg border border-[#f44336]/25 bg-[#f44336]/10 text-[#f44336] transition-colors group-hover:bg-[#f44336] group-hover:text-black">
			<Icon size={iconSize} />
		</span>
		<div class="min-w-0 flex-1">
			<h3 class="mb-1 text-sm font-bold leading-snug text-white">{title}</h3>
			{text && <p class="mb-0 text-sm leading-5 text-[#b3b8b2]">{text}</p>}
		</div>
	</article>
) : (
	<article
		class:list={[
			'flex flex-col items-start rounded-2xl border border-white/10 bg-[#111618] p-5 transition duration-300 hover:-translate-y-1 hover:border-[#f44336]/50 sm:p-6',
			className,
		]}
	>
		<div class="mb-4 flex w-full items-center justify-between">
			<span class="flex size-11 items-center justify-center rounded-xl border border-[#f44336]/30 bg-[#f44336]/10 text-[#f44336]">
				<Icon size={iconSize + 2} />
			</span>
			{number && (
				<span class="font-mono text-sm font-bold tracking-widest text-white/40">{number}</span>
			)}
		</div>
		<h3 class="mb-2 text-base font-bold leading-snug text-white">{title}</h3>
		{text && <p class="mb-0 text-sm leading-relaxed text-[#b3b8b2]">{text}</p>}
	</article>
)}
